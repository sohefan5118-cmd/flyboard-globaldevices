+// GetDevices fetches the panel-aggregated global device snapshot.
+// It is used as a REST fallback when WebSocket sync.devices is unavailable.
+func (c *Client) GetDevices() (map[int][]string, error) {
+	path := "/api/v1/server/UniProxy/devices"
+	if c.machineID > 0 {
+		path = "/api/v2/server/devices"
+	}
+	resp, err := c.doRequest("GET", path, nil, "")
+	if err != nil {
+		return nil, fmt.Errorf("get devices: %w", err)
+	}
+	defer drainAndClose(resp.Body)
+
+	if resp.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(io.LimitReader(resp.Body, 4096))
+		return nil, fmt.Errorf("status %d: %s", resp.StatusCode, body)
+	}
+
+	var devicesResp DevicesResponse
+	if err := json.NewDecoder(resp.Body).Decode(&devicesResp); err != nil {
+		return nil, fmt.Errorf("decode devices: %w", err)
+	}
+	return devicesResp.Users, nil
+}

+// userEmail returns the stats-tracking email for a user auth credential.
+// The canonical UUID keeps the legacy "user@<id>" form; aliases get a stable
+// suffix so xray UserManager can add/remove each credential independently.
+func userEmail(userID int, auth ...string) string {
+	if len(auth) == 0 || auth[0] == "" {
+		return fmt.Sprintf("user@%d", userID)
+	}
+	sum := sha1.Sum([]byte(auth[0]))
+	return fmt.Sprintf("user@%d@%x", userID, sum[:4])
+}
+
+func userAuthEmail(u model.UserSpec, auth string) string {
+	if auth == "" || auth == u.UUID {
+		return userEmail(u.ID)
+	}
+	return userEmail(u.ID, auth)
 }
 

+    private function protectResponseContent(Response $response, array $parsed, Request $request, mixed $user): Response
+    {
+        if (!in_array($parsed['format'] ?? 'unknown', ['base64', 'plain'], true)) {
+            return $response;
+        }
+
+        $lines = $this->protectUriLines($this->extractUriLines($parsed['decoded'] ?? ''), $request, $user, 'local');
+        if (empty($lines)) {
+            return $response;
+        }
+
+        $body = implode("\r\n", $lines) . "\r\n";
+        $response->setContent(($parsed['format'] ?? '') === 'base64' ? base64_encode($body) : $body);
+        $response->headers->set('content-type', 'text/plain');
+        $response->headers->set('X-Flyboard-Node-Guard', 'protected');
+
+        return $response;
+    }

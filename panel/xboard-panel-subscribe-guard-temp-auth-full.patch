+        $minutes = (int) admin_setting('subscribe_guard_auth_window_minutes', 360);
+        $minutes = max(15, min($minutes, 10080));
+        return $minutes * 60;
+    }
+
+    public function currentUuid(mixed $user): string
+    {
+        return $this->uuidForWindow($user, $this->currentWindow());
+    }
+
+    public function previousUuid(mixed $user): string
+    {
+        return $this->uuidForWindow($user, $this->currentWindow() - 1);
+    }
+
+    public function authAliases(mixed $user): array
+    {
+        $previous = $this->previousUuid($user);
+        return $previous !== '' ? [$previous] : [];
+    }
+
+    public function userForSubscribe(mixed $user): mixed
+    {
+        if (!$this->enabled()) {
+            return $user;
+        }
+
+        $authUuid = $this->currentUuid($user);
+        if ($authUuid === '') {
+            return $user;
+        }
+
+        if (is_object($user) && method_exists($user, 'replicate')) {
+            $copy = $user->replicate();
+            $copy->exists = $user->exists ?? true;
+            $copy->id = $user->id;
+            $copy->uuid = $authUuid;
+            return $copy;
+        }
+
+        if (is_object($user)) {
+            $copy = clone $user;
+            $copy->uuid = $authUuid;
+            return $copy;
+        }
+
+        if (is_array($user)) {
+            $copy = $user;
+            $copy['uuid'] = $authUuid;
+            return $copy;
+        }
+
+        return $user;
+    }
+
+    public function serverPassword(Server $server, User $user): string
+    {
+        if (!$this->enabled()) {
+            return $server->generateServerPassword($user);
+        }
+
+        $authUuid = $this->currentUuid($user);
+        if ($authUuid === '') {
+            return $server->generateServerPassword($user);
+        }
+
+        $authUser = clone $user;
+        $authUser->uuid = $authUuid;
+
+        return $server->generateServerPassword($authUser);
+    }
+
+    private function currentWindow(): int
+    {
+        return (int) floor(time() / $this->windowSeconds());
+    }
+
+    private function uuidForWindow(mixed $user, int $window): string
+    {
+        $userId = (string) data_get($user, 'id', '');
+        $uuid = (string) data_get($user, 'uuid', '');
+        if ($userId === '' || $uuid === '') {
+            return '';
+        }
+
+        $raw = hash_hmac('sha256', implode('|', ['flyboard-node-auth-v1', $userId, $uuid, $window]), $this->secret(), true);
+        $bytes = array_values(unpack('C16', substr($raw, 0, 16)));
+        $bytes[6] = ($bytes[6] & 0x0f) | 0x40;
+        $bytes[8] = ($bytes[8] & 0x3f) | 0x80;
+        $hex = implode('', array_map(fn ($byte) => sprintf('%02x', $byte), $bytes));
+
+        return substr($hex, 0, 8) . '-'
+            . substr($hex, 8, 4) . '-'
+            . substr($hex, 12, 4) . '-'
+            . substr($hex, 16, 4) . '-'
+            . substr($hex, 20, 12);
+    }
+
+    private function secret(): string
+    {
+        $key = (string) config('app.key', '');
+        if (str_starts_with($key, 'base64:')) {
+            $decoded = base64_decode(substr($key, 7), true);
+            if (is_string($decoded) && $decoded !== '') {
+                return $decoded;
+            }
+        }
+        return $key !== '' ? $key : (string) admin_setting('app_url', 'flyboard');
+    }
+}
